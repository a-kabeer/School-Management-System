SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-domain.example

# PostgreSQL is required. Either set the discrete values below,
# or a single DATABASE_URL (which takes precedence).
DB_NAME=school_management
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_TEST_NAME=school_management_test
# DATABASE_URL=postgres://user:password@host:5432/school_management

TIME_ZONE=Asia/Karachi
LANGUAGE_CODE=en

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Optional notification transports (dotted paths to a NotificationBackend)
# SMS_BACKEND=apps.notifications.backends.NullBackend
# WHATSAPP_BACKEND=apps.notifications.backends.NullBackend
# PUSH_BACKEND=apps.notifications.backends.NullBackend

# Static / media
STATIC_URL=/static/
MEDIA_URL=/media/
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,docx,xlsx

# Production security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
LOG_LEVEL=INFO
